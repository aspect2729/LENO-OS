# Supabase project (API) — Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres (Drizzle) — Project Settings → Database → Connection string (URI).
# Use the Session / Direct connection for `npm run db:migrate`.
# The Transaction pooler URL is fine for the Next.js app at runtime.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Vercel AI SDK providers
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Model ids (never hard-coded in source — set them here)
WRITER_MODEL=gemini-1.5-flash
CRITIC_MODEL=llama-3.3-70b-versatile

# Bluesky publishing (used later)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
